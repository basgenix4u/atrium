# ===========================================
# DATABASE (required at runtime)
# ===========================================
# PostgreSQL connection string. Include ?sslmode=require for hosted providers
# (Vercel Postgres, Neon, Supabase, …).
# Examples:
#   postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ===========================================
# PRIVATE OFFICE (required in production)
# ===========================================
# Secret used to sign Private Office session cookies.
# Generate with: openssl rand -base64 32
# The app refuses to boot in production with the built-in default.
PRIVATE_OFFICE_SECRET="change-me-generate-with-openssl-rand-base64-32"

# Access code for the Private Office. Defaults to a demo value (ATRIUM-2026) —
# set a unique code in production.
PRIVATE_OFFICE_CODE="change-me-unique-access-code"

# ===========================================
# SITE (recommended)
# ===========================================
# Public base URL — used for SEO metadata (canonical, OpenGraph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
